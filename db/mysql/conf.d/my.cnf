[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
default-time-zone    = '+09:00'
# ローカル練習用のためバイナリログは不要（大量seed時にディスクを倍消費するため無効化）
disable-log-bin
# 大量seed向け。8.4 で既定が none になった change buffering を戻し、
# セカンダリインデックスへのランダム挿入をバッファする（500万件で約3倍速くなった）
innodb_change_buffering  = all
# redo ログを既定の100MBから広げ、チェックポイントの頻度を下げる
innodb_redo_log_capacity = 2G

[client]
default-character-set = utf8mb4
